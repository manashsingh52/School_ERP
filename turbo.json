{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "lint": {},
    "dev": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "inputs": [
        "prisma/schema.prisma",
        "scripts/gen-tenant-models.mjs"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  },
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "futureFlags": {
    "pruneIncludesGlobalFiles": true
  }
}
