# Every environment variable the project reads, with empty values.
# The apps don't read this root file. Copy the parts you need into:
#   apps/api/.env          (start from apps/api/.env.example — it has working local-development defaults)
#   apps/web/.env.local    (start from apps/web/.env.example)
# Validation rules and defaults: apps/api/src/config/env.ts. Explanations: HANDOFF.md §4.
# Never commit real values. .env and .env.* are git-ignored (except *.example).

# ===================== API — apps/api/.env =====================
NODE_ENV=
PORT=
LOG_LEVEL=

# Database (local: embedded Postgres from `pnpm db:start`)
PG_PORT=
DATABASE_URL=
APP_DATABASE_URL=
PLATFORM_DATABASE_URL=
QUEUE_DATABASE_URL=
DB_POOL_SIZE=

# Access tokens (`pnpm --filter @schoolos/api keys:generate`)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=
ACCESS_TOKEN_TTL_SECONDS=

# One-time codes / SMS
OTP_PEPPER=
OTP_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# Domains and URLs
APP_BASE_DOMAIN=
PUBLIC_API_URL=

# Demo data (local only)
SEED_PASSWORD=

# Shared secrets with the web app / edge
BFF_SHARED_SECRET=
EDGE_SHARED_SECRET=

# Background jobs
QUEUE_BACKEND=
REDIS_URL=
RUN_WORKERS=

# File storage
STORAGE_DRIVER=
STORAGE_SIGNING_SECRET=
STORAGE_LOCAL_DIR=
STORAGE_LOCAL_URL_BASE=
GCS_PROJECT_ID=
GCS_PRIVATE_BUCKET=
GCS_PUBLIC_BUCKET=

# Notification channels
PUSH_PROVIDER=
SMS_PROVIDER=
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# PDFs
PDF_RENDERER=
CHROMIUM_PATH=

# Payments
PAYMENTS_GATEWAY=
PAYMENT_SECRETS_KEY=

# AI assistant
AI_PROVIDER=
GEMINI_API_KEY=
AI_MODEL=

# Video meetings (Jitsi)
MEETING_BASE_URL=

# Mobile app version gate and store links
MOBILE_MIN_VERSION=
MOBILE_LATEST_VERSION=
MOBILE_ANDROID_URL=
MOBILE_IOS_URL=

# ===================== Web — apps/web/.env.local =====================
API_URL=
# APP_BASE_DOMAIN=        (same as above)
# BFF_SHARED_SECRET=      (must equal the API's)
# EDGE_SHARED_SECRET=     (cloud only)
CLIENT_IP_HEADER=

# ===================== Scripts / tests only =====================
# apps/api/scripts/setup-roles.mjs (creates database roles in the cloud)
ADMIN_DATABASE_URL=
OWNER_PASSWORD=
APP_PASSWORD=
PLATFORM_PASSWORD=
# API test log level
TEST_LOG_LEVEL=
