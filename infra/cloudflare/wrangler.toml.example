# Copy to wrangler.toml, fill in, then: npx wrangler deploy && npx wrangler secret put EDGE_SECRET
# (EDGE_SECRET = the value of the edge-shared-secret in Google Secret Manager.)
name = "schoolos-edge"
main = "worker.js"
compatibility_date = "2026-10-01"

routes = [
  { pattern = "*.bastaa.in/*", zone_name = "bastaa.in" },
  { pattern = "bastaa.in/*", zone_name = "bastaa.in" },
]

[vars]
BASE_DOMAIN = "bastaa.in"
API_ORIGIN = "https://schoolos-api-XXXXXXXX.asia-south1.run.app"
WEB_ORIGIN = "https://schoolos-web-XXXXXXXX.asia-south1.run.app"
