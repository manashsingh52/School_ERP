# Server-side only (never exposed to the browser)
API_URL=http://localhost:4000
# Schools live at <slug>.<APP_BASE_DOMAIN>; locally http://demo.localhost:3000
APP_BASE_DOMAIN=localhost
# Must equal BFF_SHARED_SECRET in apps/api/.env
BFF_SHARED_SECRET=

# Cloud only (infra/README.md): must equal EDGE_SHARED_SECRET in the API. Leave unset locally.
# EDGE_SHARED_SECRET=
# CLIENT_IP_HEADER=cf-connecting-ip

# Public website only (home, privacy, terms), e.g. on Vercel before the API exists. Hides sign-in.
# SITE_ONLY=true
# Or the whole product with the recorded sample school and no API (demo/fixtures.json). Changes aren't saved.
# DEMO_MODE=true
