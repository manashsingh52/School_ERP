{
  "name": "@schoolos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --copy-files",
    "dev": "pnpm generate && concurrently -k -n swc,node \"swc src -d dist --strip-leading-paths -w\" \"node --enable-source-maps --env-file-if-exists=.env --watch-path=dist dist/main.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:start": "node --env-file-if-exists=.env scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev && node --env-file-if-exists=.env scripts/apply-sql.mjs",
    "db:deploy": "prisma migrate deploy && node --env-file-if-exists=.env scripts/apply-sql.mjs",
    "db:seed": "pnpm generate && pnpm build && node --env-file-if-exists=.env dist/seed/seed.js",
    "keys:generate": "node scripts/generate-keys.mjs",
    "db:reset": "prisma migrate reset --force && node --env-file-if-exists=.env scripts/apply-sql.mjs && pnpm db:seed",
    "generate": "prisma generate && node scripts/gen-tenant-models.mjs",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-db.mjs",
    "worker": "node --enable-source-maps --env-file-if-exists=.env dist/worker.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@schoolos/contracts": "workspace:*",
    "@schoolos/permissions": "workspace:*",
    "bullmq": "^6.3.11",
    "express": "^5.1.0",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "papaparse": "^5.7.0",
    "pg": "^8.16.0",
    "pino": "^10.4.0",
    "read-excel-file": "^9.3.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "pino-pretty": "^13.1.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^5.0.3"
  }
}
