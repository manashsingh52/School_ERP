# ---- Local development (copy to .env) ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Local Postgres started by `pnpm db:start` (embedded PostgreSQL 17, no Docker needed)
PG_PORT=54329
# Owner role: migrations only
DATABASE_URL=postgresql://schoolos_owner:owner_dev_pw@localhost:54329/schoolos
# Runtime role, subject to Row-Level Security
APP_DATABASE_URL=postgresql://schoolos_app:app_dev_pw@localhost:54329/schoolos
# Platform role, bypasses RLS: auth, super admin, cross-school jobs only
PLATFORM_DATABASE_URL=postgresql://schoolos_platform:platform_dev_pw@localhost:54329/schoolos

# Ed25519 keys for access tokens. Generate with: pnpm --filter @schoolos/api keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=schoolos-local

# Pepper for OTP hashes (any long random string locally)
OTP_PEPPER=local-dev-pepper-change-me-0123456789
# console = print OTP codes to the API log (no SMS is sent)
OTP_PROVIDER=console

# Base domain for school subdomains (web runs on http://<slug>.localhost:3000)
APP_BASE_DOMAIN=localhost

# Seed data password for all demo users (local only, never use in staging/prod)
SEED_PASSWORD=Demo@12345

# Shared with apps/web (BFF) so the API sees real client IPs (generate any 32+ char random string)
BFF_SHARED_SECRET=

# ---- Background jobs (BullMQ). V1 queues live in PostgreSQL — no Redis needed. ----
QUEUE_BACKEND=postgres
# Lean mode: the API process also runs the outbox relay + job processors (worker entrypoint always does)
RUN_WORKERS=true
# ⏸ LATER (only if QUEUE_BACKEND=redis, e.g. Upstash): redis://...
REDIS_URL=

# ---- File storage ----
# local = files under apps/api/.data/storage (development only); gcs = Google Cloud Storage
STORAGE_DRIVER=local
# Signs local upload/download links (any 32+ char random string)
STORAGE_SIGNING_SECRET=
# ⏸ LATER (staging/production): Google Cloud Storage
GCS_PROJECT_ID=
GCS_PRIVATE_BUCKET=
GCS_PUBLIC_BUCKET=

# ---- SMS / OTP ----
# ⏸ LATER (after company + DLT registration): set OTP_PROVIDER=msg91 and fill these
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# ---- Notification channels ----
# none = skip, console = print to the API log (development)
PUSH_PROVIDER=console
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# ⏸ LATER: PUSH_PROVIDER=fcm (Firebase, Phase 7), SMS_PROVIDER=msg91 (after DLT), EMAIL_PROVIDER=resend:
RESEND_API_KEY=
EMAIL_FROM=

# PDFs (report cards, receipts): chromium renders real documents; basic = plain text (CI without a browser).
PDF_RENDERER=chromium
# Chrome/Chromium binary; leave empty to use the usual install location (macOS Chrome, /usr/bin/chromium).
CHROMIUM_PATH=

# Payments: mock = local sandbox (no Razorpay account needed); razorpay = real gateway.
PAYMENTS_GATEWAY=mock
# AES-256-GCM key for schools' Razorpay secrets (pnpm keys:generate). ⏸ Secret Manager in production.
PAYMENT_SECRETS_KEY=
# Public URL of the API — shown to schools as their webhook URL.
PUBLIC_API_URL=http://localhost:4000
