// =============================================================================
// SchoolOS — V1 schema (Prisma 7). docs/schema.prisma is the reviewed copy; this file is the live one.
//
// Conventions
//  • Every tenant-owned table has `school_id` (+ RLS policy, see docs/03-multi-tenancy.md)
//  • IDs: UUID v7. Money: Int paise (`...Paise`). School-local days: @db.Date
//  • Financial rows are never updated in place except status fields; corrections are new rows
//  • Tables without school_id (global): users, sessions, otp_challenges, device_tokens,
//    platform_admins, plans, feature_flags, schools (the tenant itself)
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  // connection URL lives in prisma.config.ts (Prisma 7)
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum SchoolStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum PermissionScope {
  ALL // whole school
  ASSIGNED // sections / subjects the teacher is assigned to
  OWN_CHILDREN // guardian's linked students
  SELF // own record only
}

enum ClientPlatform {
  WEB
  ANDROID
  IOS
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  VERIFY_EMAIL
  RESET_PASSWORD
  ACTIVATE_ACCOUNT
}

enum ContactChannel {
  SMS
  EMAIL
}

enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum SubjectType {
  CORE
  ELECTIVE
  CO_SCHOLASTIC
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum StudentStatus {
  ACTIVE
  ALUMNI
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  PROMOTED
  DETAINED
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  LEFT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum HomeworkProgress {
  ASSIGNED
  VIEWED
  SUBMITTED
  REVIEWED
}

enum NoticeType {
  NOTICE
  CIRCULAR
  ANNOUNCEMENT
  EVENT
}

enum AudienceType {
  SCHOOL // everyone
  ALL_PARENTS
  ALL_TEACHERS
  ALL_STAFF
  CLASS // ref = class id (current year sections)
  SECTION // ref = section id
  ROLE // ref = role key
  MEMBERSHIP // ref = membership id (individual)
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
  WHATSAPP // V2
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  MARKS_ENTRY
  RESULTS_PUBLISHED
  ARCHIVED
}

enum ResultStatus {
  PASS
  FAIL
  WITHHELD
  INCOMPLETE
}

enum FeeHeadType {
  TUITION
  ADMISSION
  EXAM
  TRANSPORT
  ACTIVITY
  OTHER
}

enum FeeFrequency {
  ONE_TIME
  RECURRING
}

enum CalcType {
  FLAT
  PERCENT
  PER_DAY
}

enum ConcessionKind {
  SIBLING
  SCHOLARSHIP
  STAFF_WARD
  MERIT
  NEED_BASED
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoiceLineKind {
  FEE
  CONCESSION
  LATE_FEE
  ADJUSTMENT
}

enum PaymentMethod {
  ONLINE // via gateway (UPI/card/netbanking chosen inside checkout)
  CASH
  BANK_TRANSFER
  UPI_DIRECT // UPI to school account, recorded at counter
